      <aliases enabled='yes' />
      <column caption='Average Twinning Rate' datatype='real' name='[Calculation_0812876425515009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Twin_deliveries]) / SUM([Total Births]) * 1000' />
      </column>
      <column caption='Decade Growth Rate' datatype='real' name='[Calculation_0812876426240002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Twin_deliveries]) - LOOKUP(SUM([Twin_deliveries]), -10)) / LOOKUP(SUM([Twin_deliveries]), -10)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Twin to Population Ratio' datatype='real' default-format='p0.00%' name='[Calculation_0812876427689987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Twin_deliveries]) / SUM([Population_Dataset.Population]) * 100' />
      </column>
      <column caption='Total Twin Deliveries' datatype='string' name='[Calculation_0812876455108613]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Twin_deliveries]) &gt;= 1000000 THEN&#13;&#10;    STR(ROUND(SUM([Twin_deliveries]) / 1000000, 2)) + &quot;M&quot;&#13;&#10;ELSEIF SUM([Twin_deliveries]) &gt;= 1000 THEN&#13;&#10;    STR(ROUND(SUM([Twin_deliveries]) / 1000, 1)) + &quot;K&quot;&#13;&#10;ELSE&#13;&#10;    STR(SUM([Twin_deliveries]))&#13;&#10;END' />
      </column>
      <column caption='Twin Deliveries Growth %' datatype='real' name='[Calculation_0812876471066630]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;SUM(&#13;&#10;    IF [Year] = 2020 THEN [Twin_deliveries] END&#13;&#10;)&#13;&#10;-&#13;&#10;SUM(&#13;&#10;    IF [Year] = 1980 THEN [Twin_deliveries] END&#13;&#10;)&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [Year] = 1980 THEN [Twin_deliveries] END&#13;&#10;)&#13;&#10;*100' />
      </column>
      <column caption='Twin Delivery growth text' datatype='string' name='[Calculation_0812876471357447]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0812876471066630] &gt;= 0 THEN&#13;&#10;&quot;▲ &quot; + STR(ROUND([Calculation_0812876471066630], 1)) + &quot;% since 2000&quot;&#13;&#10;ELSE&#13;&#10;&quot;▼ &quot; + STR(ROUND(ABS([Calculation_0812876471066630]), 1)) + &quot;% since 2000&quot;&#13;&#10;END' />
      </column>
      <column caption='Rank Twin Deliveries' datatype='integer' name='[Calculation_2071808808419328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Twin_deliveries]))'>
          <table-calc ordering-field='[federated.1plwi3k0jiqedp1e2p7851sdfdsz].[Year]' ordering-type='Field' />
        </calculation>
      </column>
