    <worksheet name='Twin Rate per 1,000 Births'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Raleway' fontsize='8'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Merge (Master_Dataset)' name='federated.1plwi3k0jiqedp1e2p7851sdfdsz' />
          </datasources>
          <datasource-dependencies datasource='federated.1plwi3k0jiqedp1e2p7851sdfdsz'>
            <column caption='Average Twinning Rate' datatype='real' name='[Calculation_0812876425515009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Twin_deliveries]) / SUM([Total Births]) * 1000' />
            </column>
            <column datatype='integer' name='[Total Births]' role='measure' type='quantitative' />
            <column caption='Twin deliveries' datatype='integer' name='[Twin_deliveries]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0812876425515009]' derivation='User' name='[usr:Calculation_0812876425515009:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
