    <worksheet name='Total Twin Deliveries'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Raleway' fontsize='8'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Merge (Master_Dataset)' name='federated.1plwi3k0jiqedp1e2p7851sdfdsz' />
          </datasources>
          <datasource-dependencies datasource='federated.1plwi3k0jiqedp1e2p7851sdfdsz'>
            <column caption='Total Twin Deliveries' datatype='string' name='[Calculation_0812876455108613]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Twin_deliveries]) &gt;= 1000000 THEN&#13;&#10;    STR(ROUND(SUM([Twin_deliveries]) / 1000000, 2)) + &quot;M&quot;&#13;&#10;ELSEIF SUM([Twin_deliveries]) &gt;= 1000 THEN&#13;&#10;    STR(ROUND(SUM([Twin_deliveries]) / 1000, 1)) + &quot;K&quot;&#13;&#10;ELSE&#13;&#10;    STR(SUM([Twin_deliveries]))&#13;&#10;END' />
            </column>
            <column caption='Twin deliveries' datatype='integer' name='[Twin_deliveries]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0812876455108613]' derivation='User' name='[usr:Calculation_0812876455108613:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
