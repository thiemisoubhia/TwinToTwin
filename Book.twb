    <worksheet name='Decade Growth Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Raleway' fontsize='8'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Merge (Master_Dataset)' name='federated.1plwi3k0jiqedp1e2p7851sdfdsz' />
          </datasources>
          <datasource-dependencies datasource='federated.1plwi3k0jiqedp1e2p7851sdfdsz'>
            <column caption='Decade Growth Rate' datatype='real' name='[Calculation_0812876426240002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Twin_deliveries]) - LOOKUP(SUM([Twin_deliveries]), -10)) / LOOKUP(SUM([Twin_deliveries]), -10)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Twin deliveries' datatype='integer' name='[Twin_deliveries]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
            <column-instance column='[Year]' derivation='None' name='[none:Year:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0812876426240002]' derivation='User' name='[usr:Calculation_0812876426240002:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
            </column-instance>
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1plwi3k0jiqedp1e2p7851sdfdsz].[usr:Calculation_0812876426240002:qk]' included-values='non-null' />
          <slices>
            <column>[federated.1plwi3k0jiqedp1e2p7851sdfdsz].[usr:Calculation_0812876426240002:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='display' class='0' field='[federated.1plwi3k0jiqedp1e2p7851sdfdsz].[usr:Calculation_0812876426240002:qk]' scope='rows' value='false' />
