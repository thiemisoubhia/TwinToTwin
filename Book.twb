    <worksheet name='Growth'>
      <table>
        <view>
          <datasources>
            <datasource caption='Merge (Master_Dataset)' name='federated.1plwi3k0jiqedp1e2p7851sdfdsz' />
          </datasources>
          <datasource-dependencies datasource='federated.1plwi3k0jiqedp1e2p7851sdfdsz'>
            <column caption='Twin Deliveries Growth %' datatype='real' name='[Calculation_0812876471066630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM(&#13;&#10;    IF [Year] = 2020 THEN [Twin_deliveries] END&#13;&#10;)&#13;&#10;-&#13;&#10;SUM(&#13;&#10;    IF [Year] = 1980 THEN [Twin_deliveries] END&#13;&#10;)&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [Year] = 1980 THEN [Twin_deliveries] END&#13;&#10;)&#13;&#10;*100' />
            </column>
            <column caption='Twin Delivery growth text' datatype='string' name='[Calculation_0812876471357447]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0812876471066630] &gt;= 0 THEN&#13;&#10;&quot;▲ &quot; + STR(ROUND([Calculation_0812876471066630], 1)) + &quot;% since 2000&quot;&#13;&#10;ELSE&#13;&#10;&quot;▼ &quot; + STR(ROUND(ABS([Calculation_0812876471066630]), 1)) + &quot;% since 2000&quot;&#13;&#10;END' />
            </column>
            <column caption='Twin deliveries' datatype='integer' name='[Twin_deliveries]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_0812876471357447]' derivation='User' name='[usr:Calculation_0812876471357447:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' value='522' />
            <format attr='color' value='#4e79a7' />
            <format attr='text-align' value='center' />
            <format attr='vertical-align' value='center' />
          </style-rule>
          <style-rule element='label'>
